          "editorMode": "code",
          "expr": "sum(sum by (env, instance, ip) (increase(hl_p2p_tcp_bytes_total{env=~\"${env:regex}\", instance=~\"${instance:regex}\", ip=~\"${peer_ip:regex}\", direction=\"out\"}[$__range])))",
          "instant": true,
          "legendFormat": "{{env}} {{instance}} / {{ip}}",
          "range": false,
          "refId": "A"
