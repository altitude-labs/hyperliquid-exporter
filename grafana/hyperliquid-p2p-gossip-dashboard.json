        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.0.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (host, event) (\n  rate(\n    {job=\"hyperliquid\", log_type=\"gossip_connections\", host=~\"$instance\"}\n      | regexp `^\\[\"[^\"]+\",\\[\"(?P<event>[^\"]+)\"`\n    [5m]\n  )\n)",
          "legendFormat": "{{host}} · {{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Event Rate By Type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "description": "Top attributed IPv4 peers by verified gossip-RPC volume. Around 60 events/10m is consistent with a fixed 10-second loop.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Events (10m)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: events / 10 min"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green"
                    },
                    {
                      "color": "orange",
                      "value": 20
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Events (10m)"
          }
        ]
      },
      "pluginVersion": "12.0.2",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "direction": "backward",
          "editorMode": "code",
          "expr": "topk(\n  20,\n  sum by (host, ip) (\n    count_over_time(\n      {job=\"hyperliquid\", log_type=\"gossip_connections\", host=~\"$instance\"}\n        |= `\"verified gossip rpc\"`\n        | regexp `\"(Ip|ip|remote_ip|peer_ip|remote_addr|socket_addr|addr|address)\"\\s*:\\s*\"(?P<ip>[0-9]{1,3}(\\.[0-9]{1,3}){3})`\n      [10m]\n    )\n  )\n)",
          "legendFormat": "{{host}} · {{ip}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Gossip RPC Peers (10m)",
      "type": "table",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "includeByName": {},
            "indexByName": {
              "host": 0,
              "ip": 1,
              "Value": 2
            },
            "renameByName": {
              "host": "Host",
              "ip": "Peer IP",
              "Value": "Events (10m)"
            }
          }
        }
      ]
    },
